# Copy this file to .env and fill in real values. Never commit .env.

PORT=3001
CORS_ORIGIN=http://localhost:4201

DB_HOST=localhost
DB_PORT=5432
DB_NAME=mediflow_pharmacy
DB_USER=postgres
DB_PASSWORD=

JWT_SECRET=
JWT_EXPIRES_IN=7d

EXPIRY_WARNING_DAYS=30

# Password reset. FRONTEND_BASE_URL builds the emailed reset link (use https in production).
FRONTEND_BASE_URL=http://localhost:4201
PASSWORD_RESET_TTL_MINUTES=30

# SMTP settings for transactional email (e.g. Gmail app password, SendGrid, Mailgun, Brevo).
# If SMTP_HOST / MAIL_FROM are empty, no email is sent and the server logs an error.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MediFlow Pharmacy <no-reply@example.com>"

N8N_ORDER_WEBHOOK_URL=
N8N_LOW_STOCK_WEBHOOK_URL=
N8N_EXPIRY_WEBHOOK_URL=

NODE_ENV=development
